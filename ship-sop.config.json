{
  "$schema": "https://raw.githubusercontent.com/mmjclayton/ship-sop/main/docs/templates/ship-sop.schema.json",
  "trigger": {
    "mode": "auto",
    "throttle": {
      "min_diff_lines": 10,
      "skip_branch_patterns": [
        "^wip/",
        "^spike/",
        "^exp/"
      ]
    }
  },
  "agents": {
    "security-reviewer": {
      "enabled": true,
      "block_on": "CRITICAL"
    },
    "compliance-reviewer": {
      "enabled": false,
      "block_on": "CRITICAL"
    },
    "code-reviewer": {
      "enabled": true,
      "block_on": "HIGH"
    },
    "silent-failure-hunter": {
      "enabled": true,
      "block_on": "HIGH"
    },
    "pr-test-analyzer": {
      "enabled": false,
      "block_on": "never"
    },
    "diagram-builder": {
      "enabled": false,
      "block_on": "never"
    }
  }
}
